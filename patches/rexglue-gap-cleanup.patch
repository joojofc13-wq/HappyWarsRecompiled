diff --git a/src/codegen/gap_cleanup.h b/src/codegen/gap_cleanup.h
new file mode 100644
index 0000000..889ec58
--- /dev/null
+++ b/src/codegen/gap_cleanup.h
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: BSD-3-Clause
+// Range-indexed equivalent of cleanupAbsorbedGapFills' all-pairs query.
+#pragma once
+#include <algorithm>
+#include <set>
+#include <vector>
+#include <rex/codegen/function_graph.h>
+
+namespace rex::codegen {
+inline std::vector<uint32_t> FindAbsorbedGapFills(const FunctionGraph& graph) {
+  std::vector<uint32_t> gaps;
+  for (const auto& [address,node] : graph.functions())
+    if (node->authority()==FunctionAuthority::GAP_FILL) gaps.push_back(address);
+  std::sort(gaps.begin(),gaps.end());
+  std::set<uint32_t> removed;
+  for (const auto& [otherAddress,other] : graph.functions()) {
+    const uint32_t end=other->end();
+    if (end<=otherAddress) continue;
+    auto it=std::lower_bound(gaps.begin(),gaps.end(),otherAddress);
+    const auto last=std::lower_bound(gaps.begin(),gaps.end(),end);
+    for (;it!=last;++it) {
+      const uint32_t address=*it;
+      if (address==otherAddress) continue;
+      if (other->authority()==FunctionAuthority::GAP_FILL && otherAddress>=address) continue;
+      if (other->containsAddress(address)) removed.insert(address);
+    }
+  }
+  return {removed.begin(),removed.end()};
+}
+}
