diff --git a/src/graphics/d3d12/command_processor.cpp b/src/graphics/d3d12/command_processor.cpp
--- a/src/graphics/d3d12/command_processor.cpp
+++ b/src/graphics/d3d12/command_processor.cpp
@@ -3229,9 +3229,10 @@
           *node->pLastBreadcrumbValue == 0) {
         continue;
       }
-      REXGPU_ERROR("DRED breadcrumb: completed {} of {} ops", *node->pLastBreadcrumbValue,
+      const uint32_t completed = *node->pLastBreadcrumbValue;
+      REXGPU_ERROR("DRED breadcrumb: completed {} of {} ops", completed,
                    node->BreadcrumbCount);
-      uint32_t last = std::min(*node->pLastBreadcrumbValue, node->BreadcrumbCount);
+      uint32_t last = std::min(completed, node->BreadcrumbCount);
       uint32_t start = last > 3 ? last - 3 : 0;
       uint32_t end = std::min(last + 1, node->BreadcrumbCount);
       for (uint32_t i = start; i < end; i++) {
@@ -3244,6 +3245,22 @@
   D3D12_DRED_PAGE_FAULT_OUTPUT page_fault = {};
   if (SUCCEEDED(dred->GetPageFaultAllocationOutput(&page_fault)) && page_fault.PageFaultVA != 0) {
     REXGPU_ERROR("DRED page fault at VA 0x{:016X}", page_fault.PageFaultVA);
+    auto allocations = [](const char* state, const D3D12_DRED_ALLOCATION_NODE* node) {
+      unsigned count = 0;
+      for (; node && count < 64; node = node->pNext, ++count) {
+        char utf8[1024] = {};
+        const char* name = node->ObjectNameA;
+        if (!name && node->ObjectNameW) {
+          WideCharToMultiByte(CP_UTF8, 0, node->ObjectNameW, -1, utf8, sizeof(utf8), nullptr, nullptr);
+          name = utf8;
+        }
+        REXGPU_ERROR("DRED matching {} allocation: type={}, name='{}'", state,
+                     static_cast<unsigned>(node->AllocationType), name ? name : "<unnamed>");
+      }
+      if (!count) REXGPU_ERROR("DRED matching {} allocations: none", state);
+    };
+    allocations("live", page_fault.pHeadExistingAllocationNode);
+    allocations("recently freed", page_fault.pHeadRecentFreedAllocationNode);
   }
 }
 
