 void D3D12GraphicsSystem::CreateProvider(bool /*with_presentation*/) {
+  HMODULE validation_library = nullptr;
+  if (REXCVAR_GET(d3d12_gpu_based_validation)) {
+    // Enable before the first device, including the provider's adapter probes.
+    validation_library = LoadLibraryW(L"D3D12.dll");
+    auto get_debug = validation_library ? reinterpret_cast<PFN_D3D12_GET_DEBUG_INTERFACE>(
+        GetProcAddress(validation_library, "D3D12GetDebugInterface")) : nullptr;
+    Microsoft::WRL::ComPtr<ID3D12Debug1> debug;
+    const HRESULT result = get_debug ? get_debug(IID_PPV_ARGS(&debug)) : E_NOINTERFACE;
+    if (SUCCEEDED(result)) {
+      debug->EnableDebugLayer();
+      debug->SetEnableGPUBasedValidation(TRUE);
+      REXGPU_INFO("D3D12 GPU-based validation enabled before device creation");
+    }
+    debug.Reset();
+    if (FAILED(result)) {
+      if (validation_library) FreeLibrary(validation_library);
+      rex::FatalError(fmt::format("GPU-based validation is unavailable (HRESULT 0x{:08X}). "
+                      "This diagnostic test cannot run without its matching SDK layers.",
+                      unsigned(result)));
+      return;
+    }
+  }
   // D3D12 doesn't differentiate headless vs. swapchain-capable providers;
   // swapchains are created lazily per-window by the presenter.
   provider_ = rex::ui::d3d12::D3D12Provider::Create();
+  // The provider now owns a runtime reference, preserving the debug settings.
+  if (validation_library) FreeLibrary(validation_library);
+  if (provider_ && REXCVAR_GET(d3d12_gpu_based_validation)) {
+    auto* device = static_cast<rex::ui::d3d12::D3D12Provider*>(provider_.get())->GetDevice();
