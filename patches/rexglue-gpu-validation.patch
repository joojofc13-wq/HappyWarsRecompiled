+    const HRESULT result = device->QueryInterface(IID_PPV_ARGS(&messages));
+    if (SUCCEEDED(result)) {
+      messages->SetMessageCountLimit(16384);
+      REXGPU_INFO("D3D12 validation messages are captured in the game log");
+      LogD3D12ValidationMessages(device);
+    } else {
+      rex::FatalError("Cannot capture D3D12 GPU validation messages in this diagnostic test.");
+    }
+  }
 }
 
