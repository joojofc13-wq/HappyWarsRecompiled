+namespace {
+void CALLBACK ValidationMessage(D3D12_MESSAGE_CATEGORY, D3D12_MESSAGE_SEVERITY severity,
+                                D3D12_MESSAGE_ID id, LPCSTR description, void*) {
+  // The callback may run on a driver thread. Do not call D3D12 APIs here.
+  static std::atomic<unsigned> warnings{0}, errors{0};
+  if (severity <= D3D12_MESSAGE_SEVERITY_ERROR) {
+    if (errors.fetch_add(1, std::memory_order_relaxed) < 1024)
+      REXGPU_ERROR("D3D12 validation [{}]: {}", unsigned(id), description);
+  } else if (severity == D3D12_MESSAGE_SEVERITY_WARNING &&
+             warnings.fetch_add(1, std::memory_order_relaxed) < 128) {
+    REXGPU_WARN("D3D12 validation [{}]: {}", unsigned(id), description);
+  }
+}
+}  // namespace
+
+void LogD3D12ValidationMessages(ID3D12Device* device) {
+  if (!REXCVAR_GET(d3d12_gpu_based_validation)) return;
+  // Windows 10 does not expose ID3D12InfoQueue1 callbacks. Poll the original
+  // interface instead, retaining a cursor so asynchronous messages aren't
+  // discarded by ClearStoredMessages while a shader is still reporting them.
+  Microsoft::WRL::ComPtr<ID3D12InfoQueue> messages;
+  if (FAILED(device->QueryInterface(IID_PPV_ARGS(&messages)))) return;
+  static std::mutex mutex;
+  static std::unordered_map<ID3D12Device*, UINT64> cursors;
+  std::lock_guard lock(mutex);
+  auto& cursor = cursors[device];
+  const auto count = messages->GetNumStoredMessagesAllowedByRetrievalFilter();
+  if (cursor > count) cursor = 0;
+  for (; cursor < count; ++cursor) {
+    SIZE_T size = 0;
+    if (FAILED(messages->GetMessage(cursor, nullptr, &size)) || size > 1024 * 1024)
+      continue;
+    std::vector<uint8_t> storage(size);
+    auto* message = reinterpret_cast<D3D12_MESSAGE*>(storage.data());
+    if (SUCCEEDED(messages->GetMessage(cursor, message, &size)))
+      ValidationMessage(message->Category, message->Severity, message->ID,
+                        message->pDescription, nullptr);
+  }
+}
 
